// consumers.jsonc — registry of repos that consume base-webctl as a pinned
// git submodule (xrl4 §"The registry"). The release gate
// (scripts/test-all-consumers.sh) loops this list; verify-no-byte-drift.sh
// uses it to catch regression to byte-duplication. A NEW tool registers here
// at creation so the gate picks it up automatically.
//
// Fields per entry:
//   name           repo short name (and local dir name under $WEBCTL_CONSUMERS_DIR)
//   repo           git remote (for fresh clones in CI)
//   submodulePath  where the consumer mounts base (fleet-wide uniform)
//   testCmd        the consumer contract entrypoint (xrl4 §"consumer contract")
//   dockerOptIn    also expose --stack under {TOOL}_DOCKER_TESTS=1
//   tier           full | cdp-client | contracts  (capability is opt-in)
//   localDir       OPTIONAL. Absolute path (~ / $HOME allowed) to the local
//                  working copy, when its directory name is NOT the registry
//                  `name`. Omit for the normal case. Without it the gate looks
//                  only at $WEBCTL_CONSUMERS_DIR/<name>, cannot find such a
//                  repo, and reports SKIP forever while the summary still says
//                  OK — a consumer invisible to the gate that looks wired.
//   wired          true once the consumer's master actually mounts the
//                  submodule. While false the gate reports SKIP (not FAIL) —
//                  migration runs one small refactoring at a time (sb7q).
//                  A wired consumer that has not yet adopted the xrl4
//                  ./test-against-base.sh contract also reports SKIP
//                  ("contract pending"), never FAIL — the gate auto-flips to a
//                  real PASS/FAIL the instant the contract lands.
{
  "consumers": [
    {
      "name": "linkedin-webctl",
      "repo": "git@github.com:CLIAI/linkedin-webctl.git",
      "submodulePath": "vendor/base-webctl",
      "testCmd": "./test-against-base.sh --offline",
      "dockerOptIn": true,
      "tier": "full",
      // linkedin's master mounts vendor/base-webctl (9 modules adopted),
      // so it is genuinely wired. Contract adoption (./test-against-base.sh) is
      // pending — gate reports SKIP "contract pending" until it lands, then real
      // PASS/FAIL. Proven real-GREEN in a worktree 2026-06-23 (24/24 suites).
      "wired": true
    },
    {
      "name": "chatgpt-webctl",
      "repo": "git@github.com:CLIAI/chatgpt-webctl.git",
      "submodulePath": "vendor/base-webctl",
      "testCmd": "./test-against-base.sh --offline",
      "dockerOptIn": true,
      "tier": "full",
      // Flipped by webctl:base after INDEPENDENT verification (not on report):
      // submodule mounted and pinned to an exact tag (same commit as
      // substack); lib/xpra-presence.js is a one-line re-export shim, not a
      // copy; ./test-against-base.sh --offline run here -> exit 0 (1263 unit
      // tests through the shim); verify-no-byte-drift.sh clean. The adoption
      // pilot (xpra-presence: packaging-only divergence) proved the
      // submodule+shim+contract mechanism end to end.
      "wired": true
    },
    {
      "name": "telegram-webctl",
      "repo": "git@github.com:CLIAI/telegram-webctl.git",
      "submodulePath": "vendor/base-webctl",
      "testCmd": "./test-against-base.sh --offline",
      "dockerOptIn": false,
      // TIER NOTE: telegram is the ONLY consumer registered at cdp-client, and
      // base ships no CDP client — so this tier is declared but unbacked. That
      // makes telegram the FIRST adopter of the CDP-client extraction, not its
      // last: its entire registered capability is the thing being extracted.
      "tier": "cdp-client",
      // ⚠ engines.node is ">=18" here, but require(esm) — which every shim
      // depends on — needs >=22.12. Bump it in the SAME commit as telegram's
      // first shim, or the repo declares support for a runtime on which every
      // shim throws. chatgpt had the identical gap; do not rediscover it.
      // Also unfixed: lib/logging.js still rotates the shared log dir with the
      // original blanket filter (sazn). Dormant is quiet, not safe.
      "wired": false
    },
    {
      "name": "fetlife-webctl",
      // Remote corrected from CLIAI/ to gwwtests/ — verified against the
      // working copy's actual origin, not assumed from the name.
      "repo": "git@github.com:gwwtests/fetlife-webctl.git",
      "submodulePath": "vendor/base-webctl",
      "testCmd": "./test-against-base.sh --offline",
      "dockerOptIn": false,
      "tier": "contracts",
      // Twin of the substack path bug, fixed BEFORE it can bite: fetlife also
      // lives outside $WEBCTL_CONSUMERS_DIR. It is currently masked only
      // because wired:false short-circuits ahead of the path check, so the day
      // it wires it would SKIP-not-FAIL and vanish from the gate exactly as
      // substack did. Costs one line now; costs a third rediscovery later.
      "localDir": "~/github/gwwtests/fetlife-webctl",
      "wired": false
    },
    {
      "name": "claude-chrome-extension-webctl",
      // PRIVATE, in gwwtests rather than CLIAI: carries a browser profile
      // authenticated as Greg. localDir is mandatory for that reason — under
      // the old $CONSUMERS_DIR/<name> resolution this would have registered,
      // reported SKIP "repo not present", and counted as green.
      "repo": "git@github.com:gwwtests/claude-chrome-extension-webctl.git",
      "submodulePath": "vendor/base-webctl",
      "testCmd": "./test-against-base.sh --offline",
      "dockerOptIn": true,
      "tier": "full",
      "localDir": "~/github/gwwtests/claude-chrome-extension-webctl",
      "wired": false
    },
    {
      "name": "comparis-ch-webctl",
      // PRIVATE, gwwtests — same reason, same localDir requirement.
      "repo": "git@github.com:gwwtests/comparis-ch-webctl.git",
      "submodulePath": "vendor/base-webctl",
      "testCmd": "./test-against-base.sh --offline",
      "dockerOptIn": true,
      "tier": "full",
      "localDir": "~/github/gwwtests/comparis-ch-webctl",
      "wired": false
    },
    {
      "name": "gemini-webctl",
      // PRIVATE, in CLIAI. Every consumer in this org is private; only
      // base-webctl itself is public. An authenticated Gemini session IS Greg's
      // whole Google account, so this repo's secret hygiene is the strictest in
      // the family (OAuth material, API keys and conversation transcripts, not
      // just cookies).
      "repo": "git@github.com:CLIAI/gemini-webctl.git",
      "submodulePath": "vendor/base-webctl",
      "testCmd": "./test-against-base.sh --offline",
      "dockerOptIn": true,
      "tier": "full",
      // Dir name == registry name, under $WEBCTL_CONSUMERS_DIR, so no localDir
      // is needed. Stated rather than assumed: the substack/fetlife bug was a
      // silent SKIP that read as green.
      //
      // wired:true on the SAME commit as registration, which no prior consumer
      // did — master already mounts vendor/base-webctl pinned to the TAG
      // an exact tag, with a working client-config shim and the xrl4
      // contract shipped. Registering it wired:false would have been false.
      "wired": true
    },
    {
      "name": "substack-webctl",
      "repo": "git@github.com:gwwtests/lindseymackereth-substack.git",
      "submodulePath": "vendor/base-webctl",
      "testCmd": "./test-against-base.sh --offline",
      "dockerOptIn": true,
      "tier": "full",
      // Lives OUTSIDE $WEBCTL_CONSUMERS_DIR and under a different directory
      // name than its registry name, so the gate needs localDir to see it at
      // all. Until 2026-08-31 it did not have one: the gate resolved
      // ~/github/CLIAI/substack-webctl, found nothing, and reported SKIP "repo
      // not present" on every run — while the comment below claimed REAL-GREEN.
      // Contract re-run at the real path on flip day: exit 0.
      "localDir": "~/github/gwwtests/lindseymackereth-substack",
      // Registered + wired via arbitrate/promote (ubertmux-adm): proposal #1
      // (register) + #2 (this flip). FIRST family consumer to actually ship the
      // xrl4 contract: submodule mounted and pinned to an exact tag, and
      // ./test-against-base.sh --offline is green (exit 0), secret hygiene clean —
      // independently verified by webctl-mgr AND spot-checked by ubertmux-adm.
      // Gate is now REAL-GREEN on a genuinely wired+contracted consumer
      // (proof-of-recipe for the new-webctl-from-base scaffold path).
      "wired": true
    }
  ]
}
