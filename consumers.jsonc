// consumers.jsonc — registry of repos that consume base-webctl as a pinned
// git submodule (xrl4 §"The registry"). The release gate
// (scripts/test-all-consumers.sh) loops this list; verify-no-byte-drift.sh
// uses it to catch regression to byte-duplication. A NEW tool registers here
// at creation so the gate picks it up automatically.
//
// Fields per entry:
//   name           repo short name (and local dir name under $WEBCTL_CONSUMERS_DIR)
//   repo           git remote (for fresh clones in CI)
//   submodulePath  where the consumer mounts base (fleet-wide uniform)
//   testCmd        the consumer contract entrypoint (xrl4 §"consumer contract")
//   dockerOptIn    also expose --stack under {TOOL}_DOCKER_TESTS=1
//   tier           full | cdp-client | contracts  (capability is opt-in)
//   localDir       OPTIONAL. Absolute path (~ / $HOME allowed) to the local
//                  working copy, when its directory name is NOT the registry
//                  `name`. Omit for the normal case. Without it the gate looks
//                  only at $WEBCTL_CONSUMERS_DIR/<name>, cannot find such a
//                  repo, and reports SKIP forever while the summary still says
//                  OK — a consumer invisible to the gate that looks wired.
//   wired          true once the consumer's master actually mounts the
//                  submodule. While false the gate reports SKIP (not FAIL) —
//                  migration runs one small refactoring at a time (sb7q).
//                  A wired consumer that has not yet adopted the xrl4
//                  ./test-against-base.sh contract also reports SKIP
//                  ("contract pending"), never FAIL — the gate auto-flips to a
//                  real PASS/FAIL the instant the contract lands.
{
  "consumers": [
    {
      "name": "linkedin-webctl",
      "repo": "git@github.com:CLIAI/linkedin-webctl.git",
      "submodulePath": "vendor/base-webctl",
      "testCmd": "./test-against-base.sh --offline",
      "dockerOptIn": true,
      "tier": "full",
      // linkedin's master mounts vendor/base-webctl (9 modules adopted),
      // so it is genuinely wired. Contract adoption (./test-against-base.sh) is
      // pending — gate reports SKIP "contract pending" until it lands, then real
      // PASS/FAIL. Proven real-GREEN in a worktree 2026-06-23 (24/24 suites).
      "wired": true
    },
    {
      "name": "chatgpt-webctl",
      "repo": "git@github.com:CLIAI/chatgpt-webctl.git",
      "submodulePath": "vendor/base-webctl",
      "testCmd": "./test-against-base.sh --offline",
      "dockerOptIn": true,
      "tier": "full",
      // Flipped by webctl:base after INDEPENDENT verification (not on report):
      // submodule mounted and pinned to an exact tag (same commit as
      // substack); lib/xpra-presence.js is a one-line re-export shim, not a
      // copy; ./test-against-base.sh --offline run here -> exit 0 (1263 unit
      // tests through the shim); verify-no-byte-drift.sh clean. The adoption
      // pilot (xpra-presence: packaging-only divergence) proved the
      // submodule+shim+contract mechanism end to end.
      "wired": true
    },
    {
      "name": "telegram-webctl",
      "repo": "git@github.com:CLIAI/telegram-webctl.git",
      "submodulePath": "vendor/base-webctl",
      "testCmd": "./test-against-base.sh --offline",
      "dockerOptIn": false,
      // TIER NOTE: telegram is the ONLY consumer registered at cdp-client, and
      // base ships no CDP client — so this tier is declared but unbacked. That
      // makes telegram the FIRST adopter of the CDP-client extraction, not its
      // last: its entire registered capability is the thing being extracted.
      "tier": "cdp-client",
      // ⚠ engines.node is ">=18" here, but require(esm) — which every shim
      // depends on — needs >=22.12. Bump it in the SAME commit as telegram's
      // first shim, or the repo declares support for a runtime on which every
      // shim throws. chatgpt had the identical gap; do not rediscover it.
      // Also unfixed: lib/logging.js still rotates the shared log dir with the
      // original blanket filter (sazn). Dormant is quiet, not safe.
      "wired": false
    },
    {
      "name": "fetlife-webctl",
      // Remote corrected from CLIAI/ to gwwtests/ — verified against the
      // working copy's actual origin, not assumed from the name.
      "repo": "git@github.com:gwwtests/fetlife-webctl.git",
      "submodulePath": "vendor/base-webctl",
      "testCmd": "./test-against-base.sh --offline",
      // tier/dockerOptIn raised with the wired flip, not ahead of it: Greg's ask
      // (gui + browser-in-docker in every lane) makes `full` correct, but
      // registering an aspiration as a fact is what this registry has been burnt
      // by. All three flip together, after the mount was verified here.
      "dockerOptIn": true,
      "tier": "full",
      // Twin of the substack path bug, fixed BEFORE it can bite: fetlife also
      // lives outside $WEBCTL_CONSUMERS_DIR. It is currently masked only
      // because wired:false short-circuits ahead of the path check, so the day
      // it wires it would SKIP-not-FAIL and vanish from the gate exactly as
      // substack did. Costs one line now; costs a third rediscovery later.
      "localDir": "~/github/gwwtests/fetlife-webctl",
      // VERIFIED HERE, not taken from the lane's report: master 51dd3fb clean and
      // pushed; describe --tags --exact-match -> an exact tag; type:module with
      // engines.node >=22.12. ⭐ This is the FIRST ESM consumer — every other
      // wired lane is CJS and reaches base through the require(esm) shim.
      "wired": true
    },
    {
      "name": "claude-chrome-extension-webctl",
      // PRIVATE, in gwwtests rather than CLIAI: carries a browser profile
      // authenticated as Greg. localDir is mandatory for that reason — under
      // the old $CONSUMERS_DIR/<name> resolution this would have registered,
      // reported SKIP "repo not present", and counted as green.
      "repo": "git@github.com:gwwtests/claude-chrome-extension-webctl.git",
      "submodulePath": "vendor/base-webctl",
      "testCmd": "./test-against-base.sh --offline",
      "dockerOptIn": true,
      "tier": "full",
      "localDir": "~/github/gwwtests/claude-chrome-extension-webctl",
      // ⛔ FLIPPED false → true 2026-09-27, because THE GATE CAUGHT THIS FILE
      // LYING. The stale-entry detector reported "wired:false but submodule
      // mounted", and the mount is real: gitlink b2620e9, which
      // `describe --tags --exact-match` names v0.7.0, with the submodule checked
      // out and **ten-plus non-vendor files importing it** (ccew-webctl.js,
      // lib/cdp-client.js, lib/mounts-with-extensions.js, lib/client-config.js,
      // lib/modes.js, …). This was not an aspiration registered early; it was a
      // real consumer the registry under-reported, and every gate run counted it
      // as a skip.
      //
      // ⚠ PINNED AT v0.7.0 — **7 minor releases / 11 tags / 71 commits** behind
      // (measured; webctl:mgr corrected my first figure of "six releases", which
      // I had eyeballed from the version numbers instead of counting the tags).
      // So this entry becoming visible to the gate is the START of a conversation
      // about a very old pin, not the end of one. Its own test/pin-by-tag.test.js exists, but the xrl4
      // contract (./test-against-base.sh) does NOT, so the gate reports SKIP
      // "contract pending" rather than FAIL.
      //
      // ⚠ And its working tree is currently DIRTY (2 files), which the gate
      // skips ahead of any swap — so flipping this does not touch a lane that is
      // mid-edit. Verified read-only here before the flip.
      "wired": true
    },
    {
      "name": "comparis-ch-webctl",
      // PRIVATE, gwwtests — same reason, same localDir requirement.
      "repo": "git@github.com:gwwtests/comparis-ch-webctl.git",
      "submodulePath": "vendor/base-webctl",
      "testCmd": "./test-against-base.sh --offline",
      "dockerOptIn": true,
      "tier": "full",
      "localDir": "~/github/gwwtests/comparis-ch-webctl",
      "wired": false
    },
    {
      "name": "gemini-webctl",
      // PRIVATE, in CLIAI. Every consumer in this org is private; only
      // base-webctl itself is public. An authenticated Gemini session IS Greg's
      // whole Google account, so this repo's secret hygiene is the strictest in
      // the family (OAuth material, API keys and conversation transcripts, not
      // just cookies).
      "repo": "git@github.com:CLIAI/gemini-webctl.git",
      "submodulePath": "vendor/base-webctl",
      "testCmd": "./test-against-base.sh --offline",
      "dockerOptIn": true,
      "tier": "full",
      // Dir name == registry name, under $WEBCTL_CONSUMERS_DIR, so no localDir
      // is needed. Stated rather than assumed: the substack/fetlife bug was a
      // silent SKIP that read as green.
      //
      // wired:true on the SAME commit as registration, which no prior consumer
      // did — master already mounts vendor/base-webctl pinned to the TAG
      // an exact tag, with a working client-config shim and the xrl4
      // contract shipped. Registering it wired:false would have been false.
      "wired": true
    },
    {
      "name": "perplexity-webctl",
      "repo": "git@github.com:CLIAI/perplexity-webctl.git",
      "submodulePath": "vendor/base-webctl",
      "testCmd": "./test-against-base.sh --offline",
      "dockerOptIn": false,
      // TIER = contracts, which is NOT what the lane proposed, and the reason is
      // this registry's own scar: it has been burnt by registering an aspiration
      // as a fact (see fetlife above). Measured here, not taken from the report:
      // the submodule is mounted, and NO file outside vendor/ imports it yet. So
      // every browser-capability tier is a statement about future code.
      // `full` overclaims (they drive two EXISTING browsers — Chromium and Opera
      // — in xq zones over forwarded CDP, not base's chromium-docker-xpra
      // driver). `cdp-client` is the right eventual answer and would make
      // perplexity the SECOND adopter of the CDP-client extraction after
      // telegram, whose note explains that the tier is declared-but-unbacked
      // because base ships no CDP client. ⇒ Flip to cdp-client when an import
      // exists, not before.
      //
      // ⚠ `tier` is PURELY DESCRIPTIVE — measured 2026-09-27: it is read into a
      // variable by test-all-consumers.sh, verify-no-byte-drift.sh and
      // probe-contract-capability.sh and then used only as an envelope label. It
      // selects no probes. So a wrong tier cannot produce a vacuous green; it
      // misinforms the humans and the JSONL readers, which is why it still gets
      // the honest value rather than the flattering one.
      // ✅ FLIPPED contracts -> cdp-client 2026-09-27, on the condition I stated when
      // registering: a real import now exists. The lane reports a single vendor
      // importer (lib/base.mjs) whose connect() runs on base's CdpSession, with live
      // QA green on BOTH its targets — one Chromium, one Opera. ⚠ Their live QA also
      // found a real defect in that CdpSession (pending-call timers not cleared on
      // socket close, so a process outlived its work by the full command timeout),
      // which is the strongest evidence the import is real rather than declared.
      //
      // ⚠ telegram's note still applies and is now half-resolved: base ships a CDP
      // CLIENT (lib/cdp-client.js) but not the full extraction telegram's tier
      // anticipated. Two lanes now register cdp-client; the first was declared-and-
      // unbacked, the second is backed by an import.
      "tier": "cdp-client",
      // No localDir: verified the repo is at ~/github/CLIAI/perplexity-webctl and
      // the directory name equals the registry name. Stated rather than assumed —
      // the substack/fetlife bug was a silent SKIP that read as green.
      //
      // ⭐ ON `main`, NOT `master`. The wired definition above says "master";
      // that wording is the registry's, not the gate's — the gate never resolves
      // a branch name, it uses whatever is checked out (verified by grep). Noted
      // so nobody "fixes" this repo by looking for a master branch.
      //
      // wired:true VERIFIED HERE against base's refs, not on the lane's report:
      // gitlink 7a35aba, which `describe --tags --exact-match` names v0.13.1. ⚠
      // The lane's message quoted "v0.13.1 (2f9275c)" — 2f9275c is their OWN
      // HEAD and not a base object at all. The pin is nonetheless correct, and
      // the near-miss worth recording is that `git rev-parse v0.13.1` returns
      // 1ba45ac, the ANNOTATED TAG OBJECT, while the commit is 7a35aba. Anything
      // comparing a tag to a gitlink must ask for `v0.13.1^{commit}` or it will
      // report a false mismatch on every annotated tag this repo ships.
      //
      // The xrl4 contract is NOT present yet, so the gate reports SKIP
      // "contract pending" — never FAIL — and auto-flips to real PASS/FAIL the
      // instant ./test-against-base.sh lands. wired:true is still the correct
      // value: the gate's own stale-entry detector defines wired BY THE MOUNT,
      // so wired:false on a mounted submodule would be flagged STALE.
      "wired": true
    },
    {
      "name": "grok-webctl",
      "repo": "git@github.com:CLIAI/grok-webctl.git",
      "submodulePath": "vendor/base-webctl",
      "testCmd": "./test-against-base.sh --offline",
      "dockerOptIn": false,
      // *-webctl controller for Grok. Role only, at the lane's request: no account,
      // no host, no path.
      "tier": "contracts",
      // No localDir, and the lane asked for it to STAY absent: verified the repo is
      // at $WEBCTL_CONSUMERS_DIR/grok-webctl with the directory name equal to the
      // registry name, so none is needed now or at wiring time.
      //
      // ✅ wired:false is CORRECT and not an aspiration: verified here — 2 commits,
      // README + AGENTS only, and `ls-tree HEAD vendor/base-webctl` returns nothing.
      // There is genuinely nothing for the gate to run, so it reports SKIP "not yet
      // wired". ⚠ And because no submodule is mounted, the stale-entry detector does
      // NOT fire here — which is the check that made claude-chrome-extension's
      // wired:false a lie. The two states look the same in this file and are
      // distinguishable only by the mount, which is why the detector reads the mount.
      //
      // ⇒ Registering a lane with no code yet is consistent with this file's stated
      // purpose ("A NEW tool registers here at creation so the gate picks it up
      // automatically"), and is NOT the same as registering the webctl-template:
      // grok is a future consumer, a template is never a consumer at all, so a
      // template row could never pass or fail while this one will.
      //
      // Will pin v0.16.0 at Phase B (tag object cd5fda5 -> commit ab7d635,
      // HARNESS_GENERATION 2 at the tag), the same pin the template takes.
      // ✅ FLIPPED false -> true 2026-10-02, verified here rather than on report:
      // gitlink 52ca453 is exactly v0.17.0, working tree clean, contract present,
      // and lib/base.mjs imports base (not a mount with no consumer). The lane's
      // contract passes at its HEAD with harness generation 2 and five sabotages each
      // red; the gate will confirm independently. ⇒ The stale-entry detector would have
      // named this entry from the moment it mounted — the reason it reads the mount.
      "wired": true
    },
    {
      "name": "substack-webctl",
      "repo": "git@github.com:gwwtests/lindseymackereth-substack.git",
      "submodulePath": "vendor/base-webctl",
      "testCmd": "./test-against-base.sh --offline",
      "dockerOptIn": true,
      "tier": "full",
      // Lives OUTSIDE $WEBCTL_CONSUMERS_DIR and under a different directory
      // name than its registry name, so the gate needs localDir to see it at
      // all. Until 2026-08-31 it did not have one: the gate resolved
      // ~/github/CLIAI/substack-webctl, found nothing, and reported SKIP "repo
      // not present" on every run — while the comment below claimed REAL-GREEN.
      // Contract re-run at the real path on flip day: exit 0.
      "localDir": "~/github/gwwtests/lindseymackereth-substack",
      // Registered + wired via arbitrate/promote (ubertmux-adm): proposal #1
      // (register) + #2 (this flip). FIRST family consumer to actually ship the
      // xrl4 contract: submodule mounted and pinned to an exact tag, and
      // ./test-against-base.sh --offline is green (exit 0), secret hygiene clean —
      // independently verified by webctl-mgr AND spot-checked by ubertmux-adm.
      // Gate is now REAL-GREEN on a genuinely wired+contracted consumer
      // (proof-of-recipe for the new-webctl-from-base scaffold path).
      "wired": true
    }
  ]
}
